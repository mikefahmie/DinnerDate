{
  "name": "dinnerdate",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    
    "// Photo migration scripts": "",
    "migrate:photos": "npx ts-node scripts/migratePhotosToStorage.ts",
    "migrate:photos:status": "npx ts-node scripts/migratePhotosToStorage.ts status",
    "migrate:photos:broken": "npx ts-node scripts/migratePhotosToStorage.ts migrate-broken",
    "migrate:photos:dry-run": "npx ts-node scripts/migratePhotosToStorage.ts dry-run",
    "migrate:photos:batch": "npx ts-node scripts/migratePhotosToStorage.ts migrate-batch",
    
    "// Database and backend scripts": "",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop", 
    "supabase:reset": "supabase db reset",
    "supabase:migrate": "supabase db push",
    "supabase:generate-types": "supabase gen types typescript --local > types/supabase.ts",
    
    "// Restaurant data processing": "",
    "process:photos": "npx ts-node scripts/processRestaurantPhotos.ts process",
    "process:photos:status": "npx ts-node scripts/processRestaurantPhotos.ts status",
    
    "// Development utilities": "",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx"
  },
  "dependencies": {
    "@awesome.me/kit-7b1e712fca": "^1.0.4",
    "@expo/metro-runtime": "~5.0.4",
    "@expo/vector-icons": "^14.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/pro-duotone-svg-icons": "^7.0.0",
    "@fortawesome/pro-light-svg-icons": "^7.0.0",
    "@fortawesome/pro-regular-svg-icons": "^7.0.0",
    "@fortawesome/pro-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "@fortawesome/react-native-fontawesome": "^0.3.2",
    "@hookform/resolvers": "^5.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.2",
    "@react-navigation/bottom-tabs": "^7.3.17",
    "@react-navigation/native": "^7.1.11",
    "@react-navigation/native-stack": "^7.3.16",
    "@rneui/base": "^4.0.0-rc.7",
    "@rneui/themed": "^4.0.0-rc.8",
    "@supabase/supabase-js": "^2.55.0",
    "dotenv": "^17.2.1",
    "expo": "~53.0.11",
    "expo-constants": "~17.1.6",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.58.1",
    "react-native": "0.79.3",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.20.0",
    "react-native-url-polyfill": "^2.0.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "@types/react-native": "^0.72.8",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  },
  "private": true
}